# Public browser build parameters, never put API keys or server credentials here.
# Copy to web/.env.local for local development/builds.
# For production-only values use web/.env.production.local or build platform env.
VITE_TOKENDANCE_APP_URL=
VITE_TOKENDANCE_KEY_NAME=
VITE_TOKENDANCE_MODEL=
# Set only after the public repository has been created and published.
# Planned upstream repository: https://github.com/jueyunai/TypeTada-public
# Forks should use their own repository URL.
VITE_GITHUB_REPOSITORY_URL=
# Optional site filing numbers shown in the footer, e.g. 粤ICP备XXXXXXXX号-1
# and 粤公网安备XXXXXXXXXXXXXX号. Use your own site's numbers; leave empty to hide.
VITE_SITE_ICP_FILING=
VITE_SITE_PUBLIC_SECURITY_FILING=
